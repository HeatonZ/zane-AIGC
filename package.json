{
  "name": "zane-aigc-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "node scripts/run-tests.mjs",
    "start": "node dist-server/index.js --production",
    "start:prod": "npm run build && npm run start",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run test:smoke && npm run test:commerce:smoke",
    "test:smoke": "node scripts/smoke-server.mjs",
    "prestart:prod": "node scripts/stop-production-server.mjs",
    "scene:install:commerce": "node --import tsx scripts/install-commerce-pack.mjs",
    "test:commerce:smoke": "node scripts/smoke-commerce-pack.mjs",
    "scene:install:long-video": "node --import tsx scripts/install-long-text-video.mjs",
    "test:long-video:smoke": "node scripts/smoke-long-text-video.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "js-md5": "^0.9.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
