{
  "name": "zane-aigc-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "node scripts/run-tests.mjs",
    "start": "node dist-server/index.js --production",
    "watch:prod": "node scripts/watch-production.mjs",
    "start:prod": "npm run update:prod",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run test:smoke && npm run test:feedback:smoke && npm run test:commerce:smoke && npm run docs:ai:check && npm run test:ai:smoke && npm run test:basic:smoke && npm run test:dual-video:smoke && npm run test:access:smoke && npm run test:mcp:restart:smoke && npm run test:asset:execution:smoke && npm run test:long-video:smoke && npm run test:director-console:smoke && npm run test:context-video:smoke && npm run test:hermes-output:smoke && npm run test:upgrade:smoke && npm run test:commerce-ai:smoke && npm run test:public:smoke",
    "test:smoke": "node scripts/smoke-server.mjs",
    "test:hermes-output:smoke": "node scripts/smoke-hermes-output.mjs",
    "test:feedback:smoke": "node scripts/smoke-hermes-feedback.mjs",
    "scene:install:commerce": "node --import tsx scripts/install-commerce-pack.mjs",
    "test:commerce:smoke": "node scripts/smoke-commerce-pack.mjs",
    "scene:install:long-video": "node --import tsx scripts/install-long-text-video.mjs",
    "test:long-video:smoke": "node scripts/smoke-long-text-video.mjs",
    "test:context-video:smoke": "node scripts/smoke-single-context-video.mjs",
    "test:dual-video:smoke": "node --import tsx scripts/smoke-video-dual-sampling.mjs",
    "mcp": "node dist-server/mcp/index.js",
    "mcp:dev": "tsx server/mcp/index.ts",
    "docs:ai": "node --import tsx scripts/export-ai-contract.mjs",
    "docs:ai:check": "node --import tsx scripts/export-ai-contract.mjs --check",
    "ai:doctor": "node scripts/check-ai-access.mjs",
    "test:ai:smoke": "node scripts/smoke-ai.mjs",
    "test:access:smoke": "node scripts/smoke-access.mjs",
    "test:public:smoke": "node scripts/smoke-public-user.mjs",
    "test:basic:smoke": "node scripts/smoke-basic-capabilities.mjs",
    "test:hermes:smoke": "node scripts/smoke-ai.mjs --hermes",
    "test:mcp:restart:smoke": "node scripts/smoke-mcp-restart.mjs",
    "test:asset:execution:smoke": "node scripts/smoke-asset-execution.mjs",
    "update:prod": "node --import tsx scripts/update-production.mjs run --background",
    "update:prod:status": "node --import tsx scripts/update-production.mjs status",
    "test:upgrade:smoke": "node --import tsx scripts/smoke-production-upgrade.mjs",
    "scene:install:commerce-ai": "node scripts/install-commerce-ai.mjs",
    "test:commerce-ai:smoke": "node scripts/smoke-commerce-ai.mjs",
    "test:director-console:smoke": "node --import tsx scripts/smoke-long-text-director-console.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "express": "^5.1.0",
    "js-md5": "^0.9.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
