# 开发环境默认值。正式环境请复制为 .env.production 后单独修改。
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8798

# 开发和正式环境必须使用不同的数据目录。
APP_DATA_DIR=.local
DIST_DIR=dist

# Hermes 与 ComfyUI
HERMES_HOME=
# 留空时读取 Hermes Home 的端口与对应 Profile 的 API_SERVER_KEY。
HERMES_API_BASE_URL=
# 可选覆盖 API_SERVER_KEY；多 Profile 部署优先给各 Profile 单独配置密钥。
HERMES_API_KEY=
# Hermes 网络重试：次数是首次请求之外的重试次数；默认 6 次，最多 20 次。
HERMES_RETRY_ATTEMPTS=6
# 指数退避初始/最大等待时间（毫秒）。
HERMES_RETRY_INITIAL_DELAY_MS=250
HERMES_RETRY_MAX_DELAY_MS=4000
FFMPEG_BIN=
FFPROBE_BIN=
COMFYUI_BASE_URL=http://127.0.0.1:8188
# 可选默认项目根目录；也可以在“集成连接”页中设置。
ZANE_PROJECT_DIR=
# 可选单步运行超时（分钟）；应用内“集成连接”设置优先。
ZANE_WORKFLOW_TIMEOUT_MINUTES=10

# 仅供 Vite 开发服务器使用；正式环境由同一个 Node 进程提供 /api。
VITE_API_PROXY_TARGET=http://127.0.0.1:8798

# 首次未保存时的后台流程并发默认值；管理员可在「集成连接 → 系统任务并发」即时调整，SQLite保存值优先。
# 后台流程并发上限（步骤 for_each 另可配置 maxConcurrency；同地址 ComfyUI 按请求的最大值限流），范围 1–32。
ZANE_MAX_ACTIVE_RUNS=2
# 关闭服务前等待活动任务的时间（毫秒）；超时任务标记待恢复。
ZANE_SHUTDOWN_TIMEOUT_MS=15000

# 通用图片排版可选字体文件；未设置则兼容原电商字体配置/系统 Microsoft YaHei。
ZANE_IMAGE_FONT_FILE=
# 电商套图排版可选中文字体文件；默认使用系统 Microsoft YaHei。
ZANE_COMMERCE_FONT_FILE=

# 工作台 AI / stdio MCP 客户端（与 Hermes 上游 API_SERVER_KEY 不同）。
# 登录后在本人“账户与AI接入”创建；明文只返回一次。不要提交实际密钥。
ZANE_BASE_URL=http://127.0.0.1:8799
ZANE_API_TOKEN=
# 可选应急运维管理员凭证，至少32字符；正常部署留空，使用账户身份。
# 设置它不会生成浏览器管理员账户，也不会自动赋予普通用户权限。
ZANE_ADMIN_TOKEN=
# 正式服务运行时的验收构建可把上方 DIST_DIR 指向 .local/user-access-web，
# 不覆盖正式 dist；正式构建/启动前恢复 DIST_DIR=dist。

# 可选 MCP 重启代次文件：后台和 MCP 必须配置为同一个绝对路径。
# 一般留空，默认按本仓库/后台地址隔离；不保存任务、凭证或执行配置。
ZANE_MCP_RELOAD_FILE=

# 可选用户专用入口：留空不开启。与管理入口共享服务/SQLite，不是第二套工作区。
# 开启时 API_HOST 必须是 127.0.0.1/::1/localhost，公网只能转发用户端口。
# 示例用户入口端口8800；0仅用于隔离测试。
ZANE_PUBLIC_USER_PORT=
ZANE_PUBLIC_USER_HOST=127.0.0.1
# 登录限流（成功也计数）。公私入口独立账户/IP窗口，共享密码校验并行上限。
# 计数仅保存在当前进程，重启清空；来源取服务端请求IP，不信任客户端转发头。
# 同机代理会共享来源桶；TLS代理与Origin/Secure Cookie配置须另行核验。
ZANE_LOGIN_WINDOW_SECONDS=900
ZANE_LOGIN_ACCOUNT_ATTEMPTS=8
ZANE_LOGIN_SOURCE_ATTEMPTS=30
ZANE_LOGIN_MAX_CONCURRENT=4
