# 开发环境默认值。正式环境请复制为 .env.production 后单独修改。
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8799

# 开发和正式环境必须使用不同的数据目录。
APP_DATA_DIR=.local
DIST_DIR=dist

# Hermes 与 ComfyUI
HERMES_HOME=
HERMES_BIN=
COMFYUI_BASE_URL=http://127.0.0.1:8188

# 仅供 Vite 开发服务器使用；正式环境由同一个 Node 进程提供 /api。
VITE_API_PROXY_TARGET=http://127.0.0.1:8799
