# 开发环境默认值。正式环境请复制为 .env.production 后单独修改。
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8798

# 开发和正式环境必须使用不同的数据目录。
APP_DATA_DIR=.local
DIST_DIR=dist

# Hermes 与 ComfyUI
HERMES_HOME=
# 留空时读取 Hermes Home 的端口与对应 Profile 的 API_SERVER_KEY。
HERMES_API_BASE_URL=
# 可选覆盖 API_SERVER_KEY；多 Profile 部署优先给各 Profile 单独配置密钥。
HERMES_API_KEY=
FFMPEG_BIN=
FFPROBE_BIN=
COMFYUI_BASE_URL=http://127.0.0.1:8188
# 可选默认项目根目录；也可以在“集成连接”页中设置。
ZANE_PROJECT_DIR=
# 可选单步运行超时（分钟）；应用内“集成连接”设置优先。
ZANE_WORKFLOW_TIMEOUT_MINUTES=10

# 仅供 Vite 开发服务器使用；正式环境由同一个 Node 进程提供 /api。
VITE_API_PROXY_TARGET=http://127.0.0.1:8798

# 后台流程并发上限（步骤 for_each 另可配置 maxConcurrency；同地址 ComfyUI 按请求的最大值限流），范围 1–32。
ZANE_MAX_ACTIVE_RUNS=2
# 关闭服务前等待活动任务的时间（毫秒）；超时任务标记待恢复。
ZANE_SHUTDOWN_TIMEOUT_MS=15000

# 电商套图排版可选中文字体文件；默认使用系统 Microsoft YaHei。
ZANE_COMMERCE_FONT_FILE=
