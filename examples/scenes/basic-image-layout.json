{
  "format": "zane-studio-scene",
  "version": 1,
  "exportedAt": "2026-10-02T06:00:00.000Z",
  "scene": {
    "id": "basic_image_layout",
    "title": "基础图片排版",
    "shortTitle": "图片排版",
    "summary": "跨场景图片选择与多规格排版，不调用生成模型",
    "description": "素材选择 → 通用逐项画布排版。商品图、封面、海报都使用同一基础组合；只改尺寸、留白、背景和文案配置，不新建执行器。不包含电商ZIP协议或平台政策。",
    "accent": "green",
    "stages": [
      "图片与规格",
      "素材选择",
      "逐项排版"
    ],
    "cover": "/basic-image-layout.svg",
    "coverPosition": "center"
  },
  "optionPresets": [],
  "workflow": {
    "sceneId": "basic_image_layout",
    "name": "基础能力 · 图片选择与多规格排版",
    "inputs": [
      {
        "key": "images",
        "label": "源图片",
        "type": "image_list",
        "required": true
      },
      {
        "key": "selection",
        "label": "选择序号（从1开始）",
        "type": "json",
        "required": true,
        "defaultValue": {
          "images": [
            1
          ]
        }
      },
      {
        "key": "layouts",
        "label": "画布/文案规格",
        "type": "json",
        "required": true,
        "defaultValue": [
          {
            "width": 1080,
            "height": 1080,
            "margin": 40,
            "background": "#ffffff",
            "title": "",
            "caption": ""
          },
          {
            "width": 1080,
            "height": 1440,
            "margin": 40,
            "background": "#fafaf7",
            "title": "",
            "caption": ""
          }
        ]
      }
    ],
    "steps": [
      {
        "id": "references",
        "name": "基础素材选择",
        "kind": "capability",
        "capabilityId": "media.select_references",
        "capabilityVersion": "1",
        "capabilityConfig": {
          "groups": [
            {
              "key": "images",
              "kind": "image",
              "tag": "Image"
            }
          ]
        },
        "inputs": [
          {
            "key": "selection",
            "label": "选择序号",
            "sourceRef": "input.selection"
          },
          {
            "key": "images",
            "label": "源图片",
            "sourceRef": "input.images"
          }
        ],
        "outputs": [
          {
            "key": "selected",
            "label": "所选素材",
            "type": "json"
          },
          {
            "key": "prompt",
            "label": "映射提示词",
            "type": "text"
          },
          {
            "key": "reference_map",
            "label": "引用映射",
            "type": "json"
          }
        ],
        "promptTemplate": ""
      },
      {
        "id": "layout",
        "name": "基础画布与排版",
        "kind": "capability",
        "capabilityId": "media.image_layout",
        "capabilityVersion": "1",
        "inputs": [
          {
            "key": "image",
            "label": "所选图片",
            "sourceRef": "step.references.outputs.selected.images"
          },
          {
            "key": "layout",
            "label": "当前规格",
            "sourceRef": "iteration.item"
          }
        ],
        "outputs": [
          {
            "key": "images",
            "label": "排版图片",
            "type": "image_list"
          },
          {
            "key": "layout_manifest",
            "label": "排版记录",
            "type": "json"
          }
        ],
        "execution": {
          "mode": "for_each",
          "sourceRef": "input.layouts",
          "onError": "stop",
          "maxConcurrency": 2
        },
        "promptTemplate": ""
      }
    ],
    "outputs": [
      {
        "key": "images",
        "label": "所有排版图片",
        "type": "image_list",
        "sourceRef": "step.layout.outputs.images"
      },
      {
        "key": "layout_manifest",
        "label": "排版清单",
        "type": "json",
        "sourceRef": "step.layout.outputs.layout_manifest"
      },
      {
        "key": "reference_map",
        "label": "素材映射",
        "type": "json",
        "sourceRef": "step.references.outputs.reference_map"
      }
    ]
  }
}
