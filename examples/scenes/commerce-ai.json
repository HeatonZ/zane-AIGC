  "exportedAt": "2026-10-06T00:00:00.000Z",
  "scene": {
    "id": "commerce_ai",
    "title": "电商套图",
    "shortTitle": "AI套图",
    "summary": "AI直接生成完整电商套图，先确认样张",
    "description": "商品参考与需求交给AI，Writer策划整套视觉，AIXG转成完整成图提示词，基础ComfyUI直接生成包含视觉设计与所需文字的图片。自定义代码 core.code 把本次输入的商品图与风格图按 filename 合并成同一组有序参考（只选择既有媒体，不产生新媒体），交付时再按样张→剩余顺序返回原始成图；数据对齐与传递用 data.zip 与 core.code。不生成无字底图，不通过程序贴文案或排版。",
    "cover": "/commerce-pack.svg",
    "coverPosition": "center",
    "accent": "coral",
    "stages": [
      "商品与需求",
      "套图方案",
      "样张确认",
      "AI逐张生成",
      "成图交付"
    ]
  },
  "optionPresets": [],
  "workflow": {
    "sceneId": "commerce_ai",
    "name": "电商套图 · AI整图生成",
    "inputs": [
      {
        "key": "project_name",
        "label": "项目名称",
        "type": "text",
        "required": true,
        "placeholder": "例如：保温杯秋季上新"
      },
      {
        "key": "product_images",
        "label": "商品参考图（正面、角度、细节、包装；作为商品依据）",
        "type": "image_list",
        "required": true
      },
      {
        "key": "style_images",
        "label": "风格参考图（可选；只参考视觉，不作为商品事实）",
        "type": "image_list",
        "required": false
      },
      {
        "key": "product_info",
        "label": "商品真实信息",
        "type": "textarea",
        "required": true,
        "placeholder": "商品名称、真实卖点；按需补充规格、包装清单和必须保留的外观。不要填写未经核实的事实。"
      },
      {
        "key": "request",
        "label": "想生成什么样的一套图",
        "type": "textarea",
        "required": true,
        "placeholder": "例如：面向户外人群，黑灰与荧光绿视觉，生成有设计感的完整电商套图；图中需要简短中文标题。"
      },
      {
        "key": "image_count",
        "label": "套图张数（类型由AI设计，卖点图可重复）",
        "type": "select",
        "required": true,
        "options": [
          "1",
          "2",
          "3",
          "4",
          "5",
          "6",
          "7",
          "8"
        ],
        "defaultValue": "5"
      },
      {
        "key": "ratio",
        "label": "生成画幅",
        "type": "select",
        "required": true,
        "options": [
          "1:1 (Square)",
          "3:4 (Portrait Standard)",
          "4:3 (Standard)",
          "9:16 (Portrait Widescreen)",
          "16:9 (Widescreen)"
        ],
        "defaultValue": "1:1 (Square)"
      },
      {
        "key": "seed",
        "label": "随机种子",
        "type": "number",
        "required": false,
        "defaultValue": 0
      },
      {
        "key": "mp",
        "label": "生成像素（MP）",
        "type": "number",
        "required": true,
        "defaultValue": 1
      }
    ],
    "steps": [
      {
        "id": "product_brief",
        "name": "Writer · 商品事实与外观约束",
        "kind": "hermes",
        "capabilityId": "core.hermes",
        "capabilityVersion": "1",
        "inputs": [
          {
            "key": "product_images",
            "label": "商品参考图片",
            "sourceRef": "input.product_images"
          },
          {
            "key": "style_images",
            "label": "风格参考（不作为商品事实）",
            "sourceRef": "input.style_images"
          },
          {
            "key": "product_info",
            "label": "商品真实信息",
            "sourceRef": "input.product_info"
          },
          {
            "key": "request",
            "label": "生成需求",
            "sourceRef": "input.request"
          }
        ],
        "outputs": [
          {
            "key": "product_brief",
            "label": "商品事实与视觉禁区",
            "type": "text",
            "description": "仅整理用户事实和真实附件中的可见外观；区分未知信息，不能推测未见结构、参数、功效或配件。"
          }
        ],
        "promptTemplate": "你是商品资料分析Writer。只分析真实商品图片与用户资料，不调用工具，不生成图片。区分商品参考与风格参考，只整理已确认事实、可见外观、需保持的商品结构/颜色/Logo/包装文字以及未知信息。禁止把未知材质、尺寸、功效、认证、配件写成事实。资料不足不等于禁止视觉设计：可以设计背景、人物情境、光线、版式、装饰图形、放大细节和文字层级；设计表达不是商品性能证明，不要把人物、场景和图形一律列为禁区。风险与未知信息只用于内部策划，不作为消费者画面文案。只返回JSON对象，product_brief为完整文本。",
        "hermesProfile": "writer"
      },
      {
        "id": "plan",
        "name": "Writer · 整套电商视觉设计",
        "kind": "hermes",
        "capabilityId": "core.hermes",
        "capabilityVersion": "1",
        "inputs": [
          {
            "key": "product_images",
            "label": "商品依据",
            "sourceRef": "input.product_images"
          },
          {
            "key": "style_images",
            "label": "风格参考",
            "sourceRef": "input.style_images"
          },
          {
            "key": "product_brief",
            "label": "商品事实",
            "sourceRef": "step.product_brief.outputs.product_brief"
          },
          {
            "key": "request",
            "label": "用户需求",
            "sourceRef": "input.request"
          },
          {
            "key": "image_count",
            "label": "图片数量",
            "sourceRef": "input.image_count"
          },
          {
            "key": "ratio",
            "label": "画幅",
            "sourceRef": "input.ratio"
          }
        ],
        "outputs": [
          {
            "key": "visual_direction",
            "label": "共享视觉规则",
            "type": "text",
            "description": "整套最终设计的配色、字体层级、图文关系、设计元素和阅读节奏；不是仅描述摄影光线或背景。"
          },
          {
            "key": "cards",
            "label": "逐张图片计划",
            "type": "json",
            "description": "恰好image_count张完整AI成图设计；每项{id,role,goal,brief}，不输出素材选择、layout/坐标/后置文案字段。brief同时包含画面、版式、所需文字及商品约束。"
          }
        ],
        "promptTemplate": "你是电商视觉设计师，任务是策划一套可由AI直接生成的完整电商设计稿，不是整理商品照片，也不是为后续排版生成底图。结合商品真实信息、图片、目标人群、用户需求和画幅，输出统一视觉方向visual_direction以及恰好image_count项cards。\nvisual_direction必须设计整套配色、文字层级、图文关系、装饰元素、商品呈现和跨图阅读节奏。每项只含id、role、goal、brief：id唯一；role可重复，但每张必须有明确不同的沟通任务和视觉构图，不能用正面商品换背景/换大小凑张数。role从hero/selling_point/detail/lifestyle/specs/package选择，未知规格和配件不能硬编。图1是一张完整主视觉，后续根据真实资料安排情境、可见结构、细节或主题延展；允许有设计理由的人物情境、背景、色块、线条、局部放大与视觉标注，保持商品身份和可见结构，不虚构商品性能。\nbrief是一张完整成图的自然语言设计要求：写明主体构图、背景、图形元素、商品大小位置、视觉焦点、文字层级及需要出现在图中的准确短文案。需要文字时直接在brief中用引号列出，不拆成后置文案字段；用户要求无字时仍设计完整画面。图文在AI生图时一体生成，不要求预留给程序填字，不禁止图中有文字。消费者文案要简短自然，不能把“面向某某人群”“未经验证的性能”等内部策划/风险说明写进成图。不得编造品牌、参数、功效、认证或价格；资料少仍要完成视觉设计，不得退化为五张重复白底图。\n不要求Writer选择或编号素材。自定义代码步骤已把本次输入中的全部商品图和风格图（若有）按商品→风格顺序合并成同一组有序参考图，每张设计都收到这组附件；风格图仅作视觉参考。brief如需引用素材使用<Product 1>、<Style 1>等真实分组标签，由reference_map映射为真实附件序号<Picture N>，不能生成路径。不要输出layout、宽高、坐标、字体文件或独立文案列表，不为后期排版设计。只返回JSON对象visual_direction和cards，不调用生图工具。",
        "hermesProfile": "writer"
      },
      {
        "id": "plan_contract",
        "name": "自定义代码 · 校验套图计划数量、结构与唯一标识",
        "kind": "capability",
        "capabilityId": "core.code",
        "capabilityVersion": "1",
        "inputs": [
          {
            "key": "cards",
            "label": "套图计划",
            "sourceRef": "step.plan.outputs.cards"
          },
          {
            "key": "image_count",
            "label": "请求图片数量",
            "sourceRef": "input.image_count"
          }
        ],
        "outputs": [
          {
            "key": "rows",
            "label": "逐张记录",
            "type": "json"
          },
          {
            "key": "first",
            "label": "首张样张任务",
            "type": "json"
          },
          {
            "key": "rest",
            "label": "剩余任务",
            "type": "json"
          }
        ],
        "promptTemplate": "",
        "capabilityConfig": {
          "code": "const roles = [\"hero\",\"selling_point\",\"detail\",\"lifestyle\",\"specs\",\"package\"];\nconst cards = inputs.cards;\nif (!Array.isArray(cards)) throw new Error(\"套图计划必须是数组\");\nconst expected = Number(inputs.image_count);\nif (!Number.isInteger(expected) || cards.length !== expected) throw new Error(\"套图计划数量与请求张数不一致：期望 \" + inputs.image_count + \" 张，实际 \" + cards.length + \" 项\");\nconst seen = new Set();\ncards.forEach((card, index) => {\n  const position = index + 1;\n  if (!card || typeof card !== \"object\" || Array.isArray(card)) throw new Error(\"第 \" + position + \" 项必须是对象\");\n  if (typeof card.id !== \"string\" || !card.id.trim() || card.id.length > 64) throw new Error(\"第 \" + position + \" 项 id 必须是非空字符串且不超过64字\");\n  if (seen.has(card.id)) throw new Error(\"套图计划 id 重复：\" + card.id);\n  seen.add(card.id);\n  if (!roles.includes(card.role)) throw new Error(\"第 \" + position + \" 项 role 必须是 \" + roles.join(\"/\") + \"，当前为 \" + JSON.stringify(card.role));\n  if (typeof card.goal !== \"string\" || !card.goal.trim() || card.goal.length > 500) throw new Error(\"第 \" + position + \" 项 goal 必须是非空字符串且不超过500字\");\n  if (typeof card.brief !== \"string\" || !card.brief.trim() || card.brief.length > 6000) throw new Error(\"第 \" + position + \" 项 brief 必须是非空字符串且不超过6000字\");\n});\nreturn { rows: cards, first: cards[0] ?? null, rest: cards.slice(1) };",
          "timeoutMs": 5000
        }
      },
      {
        "id": "references",
        "name": "自定义代码 · 合并商品与风格参考",
        "kind": "capability",
        "capabilityId": "core.code",
        "capabilityVersion": "1",
        "inputs": [
          {
            "key": "product_images",
            "label": "商品参考图（按上传顺序）",
            "sourceRef": "input.product_images"
          },
          {
            "key": "style_images",
            "label": "风格参考图（可选）",
            "sourceRef": "input.style_images"
          }
        ],
        "outputs": [
          {
            "key": "images",
            "label": "本套图有序参考图",
            "type": "image_list",
            "description": "按商品→风格顺序选择本次输入中的既有图片，供每张设计使用同一组附件"
          },
          {
            "key": "reference_map",
            "label": "素材局部编号",
            "type": "json"
          },
          {
            "key": "count",
            "label": "参考图数量",
            "type": "number"
          }
        ],
        "promptTemplate": "",
        "capabilityConfig": {
          "code": "const product = (inputs.product_images ?? []).map(item => item.filename);\nconst style = (inputs.style_images ?? []).map(item => item.filename);\nconst reference_map = [];\nproduct.forEach((filename, index) => reference_map.push({ asset: \"<Product \" + (index + 1) + \">\", reference: \"<Picture \" + (index + 1) + \">\" }));\nstyle.forEach((filename, index) => reference_map.push({ asset: \"<Style \" + (index + 1) + \">\", reference: \"<Picture \" + (product.length + index + 1) + \">\" }));\nreturn { images: [...product, ...style], reference_map, count: product.length + style.length };",
          "timeoutMs": 5000
        }
      },
      {
        "id": "prompt_jobs",
        "name": "自定义代码 · 方案与素材编号对齐并确认",
        "kind": "capability",
        "capabilityId": "core.code",
        "capabilityVersion": "1",
        "inputs": [
          {
            "key": "rows",
            "label": "已校验的套图计划",
            "sourceRef": "step.plan_contract.outputs.rows"
          },
          {
            "key": "reference_map",
            "label": "素材局部编号",
            "sourceRef": "step.references.outputs.reference_map"
          }
        ],
        "outputs": [
          {
            "key": "rows",
            "label": "逐张记录",
            "type": "json"
          },
          {
            "key": "count",
            "label": "待生成张数",
            "type": "number"
          }
        ],
        "promptTemplate": "",
        "capabilityConfig": {
          "code": "const rows = inputs.rows ?? [];\nconst map = inputs.reference_map ?? [];\nreturn { rows: rows.map(card => ({ card, reference_map: map })), count: rows.length };",
          "timeoutMs": 5000
        },
        "review": {
          "enabled": true,
          "instruction": "确认整套视觉和逐张完整设计：每张是否有不同沟通任务与构图，是否是完整电商成图而非商品照片，简短文案是否真实自然。确认后AI直接生成含设计与所需文字的图片，不做程序后置排版。"
        }
      },
      {
        "id": "prompts",
        "name": "AIXG · 完整设计转成生图提示词",
        "kind": "hermes",
        "capabilityId": "core.hermes",
        "capabilityVersion": "1",
        "inputs": [
          {
            "key": "reference_images",
            "label": "本套图有序图片附件",
            "sourceRef": "step.references.outputs.images",
            "referenceType": "image_list"
          },
          {
            "key": "card",
            "label": "本张设计方案",
