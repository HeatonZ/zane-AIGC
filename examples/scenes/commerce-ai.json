            "sourceRef": "iteration.item.reference_map"
          },
          {
            "key": "product_brief",
            "label": "商品事实与禁区",
            "sourceRef": "step.product_brief.outputs.product_brief"
          },
          {
            "key": "visual_direction",
            "label": "整套共享视觉规则",
            "sourceRef": "step.plan.outputs.visual_direction"
          }
        ],
        "outputs": [
          {
            "key": "prompt",
            "label": "本张Qwen Image编辑提示词",
            "type": "text",
            "description": "非空中文自然语言图像编辑指令，参考图片按本张实际附件顺序引用<image1>等；不包含路径、URL、生成参数或解释。"
          }
        ],
        "promptTemplate": "你负责把已经确认的电商完整设计转成Qwen图生图自然语言prompt，不调用工具。输入包括整套视觉方向、本张完整设计、商品事实与真实参考图。输出是最终电商设计稿，不是商品摄影底图，也不是等后期填字的留白模板。\n完整保留本张brief的版式、图文关系、字体层级、背景、装饰图形、放大标注、构图节奏与所需短文案；准确短文案用引号原样写入prompt，让图像模型直接生成这些文字与整个画面。不能擅自删去文字、图形或情境，不能把设计简化为“只换背景/保持居中/不要文字”。用户明确要求无字时才无字，但仍完成视觉设计。按reference_map的<Product N>/<Style N>到<Picture N>映射和当前真实附件顺序把商品与风格引用转换为<image1>、<image2>等，说明哪张提供商品事实、哪张提供视觉参考，不虚构图片编号。\n保持商品身份、颜色及真实可见结构，不添加未经确认的材质性能、尺寸、认证、品牌或配件。背景、人物情境和图形设计不等于虚构性能，不要一律禁止；不要把内部风险说明变成可见文案。prompt必须描述一张完整、可直接交付的电商设计成图，所有视觉与文字都在同一次AI生图中完成，不提程序排版、后置贴字或坐标。只返回JSON对象prompt，值为完整自然语言生图要求。",
        "hermesProfile": "aixg",
        "execution": {
          "mode": "for_each",
          "sourceRef": "step.prompt_jobs.outputs.rows",
          "onError": "stop",
          "maxConcurrency": 2
        }
      },
      {
        "id": "render_jobs",
        "name": "自定义代码 · 对齐计划与提示词",
        "kind": "capability",
        "capabilityId": "core.code",
        "capabilityVersion": "1",
        "inputs": [
          {
            "key": "cards",
            "label": "套图计划",
            "sourceRef": "step.plan.outputs.cards"
          },
          {
            "key": "prompts",
            "label": "逐张提示词",
            "sourceRef": "step.prompts.outputs.prompt"
          }
        ],
        "outputs": [
          {
            "key": "rows",
            "label": "逐张记录",
            "type": "json"
          },
          {
            "key": "first",
            "label": "首张样张任务",
            "type": "json"
          },
          {
            "key": "rest",
            "label": "剩余任务",
            "type": "json"
          }
        ],
        "promptTemplate": "",
        "capabilityConfig": {
          "code": "const cards = inputs.cards ?? [];\nconst prompts = inputs.prompts;\nif (!Array.isArray(prompts) || prompts.length !== cards.length) throw new Error(\"提示词数量与方案数量不一致：\" + cards.length + \" 项方案，\" + (Array.isArray(prompts) ? prompts.length : \"非数组\") + \" 条提示词\");\nconst rows = cards.map((card, index) => ({ card, prompt: prompts[index] }));\nreturn { rows, first: rows[0] ?? null, rest: rows.slice(1) };",
          "timeoutMs": 5000
        }
      },
      {
        "id": "sample",
        "name": "基础ComfyUI · 完整主视觉样张",
        "kind": "comfyui",
        "capabilityId": "core.comfyui",
        "capabilityVersion": "1",
        "inputs": [
          {
            "key": "reference_images",
            "label": "本套图有序参考图",
            "sourceRef": "step.references.outputs.images",
            "referenceType": "image_list"
          },
          {
            "key": "prompt",
            "label": "本张生成提示词",
            "sourceRef": "step.render_jobs.outputs.first.prompt"
          },
          {
            "key": "seed",
            "label": "随机种子",
            "sourceRef": "input.seed"
          },
          {
            "key": "ratio",
