            "sourceRef": "input.mp"
          }
        ],
        "outputs": [
          {
            "key": "images",
            "label": "AI完整成图",
            "type": "image_list"
          }
        ],
        "promptTemplate": "",
        "comfyui": {
          "workflowFile": "Zane/i2i_UI.json",
          "bindings": [
            {
              "key": "reference_images",
              "label": "本套图有序参考图",
              "direction": "input",
              "nodeId": "471",
              "property": "images",
              "type": "image_list",
              "sourceRef": "step.references.outputs.images",
              "required": true
            },
            {
              "key": "prompt",
              "label": "正向提示词",
              "direction": "input",
              "nodeId": "471",
              "property": "prompt",
              "type": "text",
              "sourceRef": "step.render_jobs.outputs.first.prompt",
              "required": true
