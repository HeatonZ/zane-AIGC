            "key": "output_1",
            "label": "新输出",
            "type": "text",
            "description": "润色后的文案"
          }
        ],
        "promptTemplate": "基于用户想法来联想并扩写画面，画面参数： {{input.ratio}}，自然语言描述主体、场景、构图、动作、细节：{{input.thought}}",
        "runCondition": {
          "conditionStepId": "step_reference_images_condition",
          "expectedResult": false
        }
      },
      {
        "id": "step_mukrnpps_3",
        "name": "整理纯文生图提示词",
        "kind": "hermes",
        "hermesProfile": "aixg",
        "inputs": [
